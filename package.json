{
  "name": "engineering-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": "22.23.2",
    "bun": "1.3.12"
  },
  "scripts": {
    "dev": "bun run fonts:generate && next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "bun scripts/validate-content.ts && bun run fonts:generate && next build",
    "preview": "bun scripts/preview.ts",
    "test:e2e": "playwright test",
    "fonts:generate": "bun scripts/prepare-fonts.ts",
    "images:generate": "bun scripts/prepare-images.ts",
    "diagrams:commerce": "bun scripts/prepare-commerce-diagrams.ts multi-vendor-e-commerce",
    "diagrams:generate": "bun scripts/prepare-commerce-diagrams.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9",
    "eslint-config-next": "16.3.5",
    "mermaid": "^12.1.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
