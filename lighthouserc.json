{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview",
      "startServerReadyPattern": "Static preview",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/profile/",
        "http://127.0.0.1:4173/projects/multi-vendor-e-commerce/"
      ],
      "numberOfRuns": 5,
      "settings": { "skipAudits": ["is-crawlable"] }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.6 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 9000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-byte-weight": ["error", { "maxNumericValue": 2000000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
